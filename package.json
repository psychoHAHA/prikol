{
  "name": "draft-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node --env-file=.env.local server/index.js",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:stratz": "node --env-file=.env.local scripts/check-stratz.js",
    "query:stratz": "node --env-file=.env.local scripts/query-stratz.js"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.2.0",
    "vitest": "^5.1.0"
  }
}
